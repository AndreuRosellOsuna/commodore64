<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The one place the version lives. Release builds override it from the tag: -p:Version=1.2.3 -->
    <Version>1.0.0</Version>
    <Product>C64 Console</Product>
    <Description>A Windows console with the look and feel of the Commodore 64.</Description>
  </PropertyGroup>
</Project>
