<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project compile on non-Windows machines (CI, Linux dev boxes). It still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>C64Console</AssemblyName>
    <RootNamespace>C64Console.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\C64Console.Core\C64Console.Core.csproj" />
  </ItemGroup>
</Project>
