<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Lets the project compile on non-Windows machines (CI, Linux dev boxes). It still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>C64Console</AssemblyName>
    <RootNamespace>C64Console.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- A self-contained single-file exe carries the whole .NET runtime; compressing it roughly halves the size. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also used as the window icon. The preview tool regenerates it (see README). -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\C64Console.Core\C64Console.Core.csproj" />
    <ProjectReference Include="..\C64Console.Pty\C64Console.Pty.csproj" />
  </ItemGroup>
</Project>
